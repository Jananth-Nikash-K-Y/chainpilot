# ChainPilot — environment configuration template.
# Copy to .env and fill in real values. Never commit .env.

# --- Application ---
APP_ENV=development

# SQLite by default — a single file, no database server to install or run.
# The file is created automatically on first start (backend/chainpilot.db).
DATABASE_URL=sqlite:///./chainpilot.db
# To use PostgreSQL instead, install the driver and use a URL like:
# DATABASE_URL=postgresql+psycopg://chainpilot:chainpilot@localhost:5432/chainpilot

# --- LLM provider (used by future agents) ---
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# --- MCP / A2A (future) ---
MCP_SERVER_URL=
A2A_SERVER_URL=

# --- Service URLs ---
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
