# ChainPilot — environment configuration template.
# Copy to .env and fill in real values. Never commit .env.

# --- Application ---
APP_ENV=development
DATABASE_URL=postgresql://chainpilot:chainpilot@localhost:5432/chainpilot

# --- LLM provider (used by future agents) ---
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# --- MCP / A2A (future) ---
MCP_SERVER_URL=
A2A_SERVER_URL=

# --- Service URLs ---
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
